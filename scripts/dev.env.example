# Copy to scripts/dev.env (git-ignored) to override local development values.
NEXUS_PORT=3000
NEXUS_DATA_DIR=D:/nexus-build/devdata
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-only-livekit-secret-change-me-0123456789
ALLOW_PUBLIC_REGISTRATION=false
CORS_ORIGINS=http://127.0.0.1:1420,http://localhost:1420
LOG_LEVEL=info
